{
  "name": "quasar-live-analysis",
  "displayName": "Quasar Live Analysis",
  "description": "Connects VS Code language providers to Quasar for live editor updates, definitions, references, hover, and diagnostics.",
  "version": "0.1.0",
  "publisher": "quasar-local",
  "files": [
    "extension.js",
    "package.json"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:quasar.connectLiveAnalysis",
    "onCommand:quasar.disconnectLiveAnalysis"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quasar.connectLiveAnalysis",
        "title": "Quasar: Connect Live Analysis"
      },
      {
        "command": "quasar.disconnectLiveAnalysis",
        "title": "Quasar: Disconnect Live Analysis"
      }
    ]
  }
}
