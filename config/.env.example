# 실사용 API 키는 이 템플릿이 아닌 .env에만 저장하세요.
# OpenAI 사용 (기본값)
AI_PROVIDER=openai
OPENAI_API_KEY=여기에_OpenAI_API_키를_입력하세요
OPENAI_MODEL=gpt-4o-mini

# 음성 인식: NVIDIA NeMo-Speech.cpp 설치 필요
# PowerShell: irm https://github.com/NVIDIA/NeMo-Speech.cpp/raw/main/scripts/install.ps1 | iex
# 첫 실행 시 Nemotron Q8 GGUF 약 707 MiB를 다운로드합니다.

# Ollama 사용
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=gemma4:cloud
# OLLAMA_API_KEY=ollama

# NVIDIA NIM 사용 (OpenAI 호환 API)
# AI_PROVIDER=nvidia_nim
# NVIDIA_API_KEY=여기에_NVIDIA_API_키를_입력하세요
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# omni 공급자 사용 (omni 모델이 오디오 입력을 직접 이해)
# 기본 엔드포인트는 NVIDIA NIM이며 NVIDIA_API_KEY를 그대로 재사용합니다.
# AI_PROVIDER=omni
# OMNI_API_KEY=여기에_OMNI_API_키를_입력하세요        # 비우면 NVIDIA_API_KEY 사용
# OMNI_BASE_URL=https://integrate.api.nvidia.com/v1
# OMNI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# 오디오 첨부 형식: audio_url (NIM/vLLM 계열, 기본값) 또는 input_audio (OpenAI 표준)
# OMNI_AUDIO_STYLE=audio_url
# 음성 인식 엔진을 "Omni (omni 모델이 음성을 직접 인식)"으로 선택하고
# 이 공급자의 omni 모델과 함께 쓰면 녹음 음성을 모델에 직접 첨부합니다.

# OpenRouter 사용
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=여기에_OpenRouter_API_키를_입력하세요
# OPENROUTER_MODEL=openai/gpt-6-luna
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# MCP 서버 설정 파일 (기본값: 작업 폴더의 .mcp.json)
# MCP_SERVERS_FILE=.mcp.json

# 요청당 최대 도구 반복 단계 수 (1-32, 기본값: 8)
# 0 또는 "unlimited"로 지정하면 작업이 끝날 때까지 무제한 반복합니다.
# QUASAR_MAX_TOOL_ROUNDS=8
# QUASAR_MAX_TOOL_ROUNDS=unlimited

# 도구 제공 방식: legacy (기본값, 전체 도구) 또는 dynamic (카테고리별 동적 로드)
# GUI에서는 설정 창에서 변경할 수 있습니다.
# QUASAR_TOOL_CALLING_MODE=legacy
